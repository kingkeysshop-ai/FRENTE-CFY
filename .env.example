# Medusa Backend (REQUIRED)
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_API_KEY=pk_your_publishable_key_here
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here

# Frontend URL (REQUIRED for webhook callback URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=co

# Aurpay (crypto payments)
AURPAY_API_KEY=your_aurpay_api_key
AURPAY_API_BASE=https://dashboard.aurpay.net
AURPAY_API_SECRET=your_aurpay_secret
AURPAY_WEBHOOK_SECRET=your_webhook_secret

# Bold (Colombia payments)
BOLD_API_KEY=your_bold_api_key
BOLD_API_URL=https://integrations.api.bold.co
BOLD_WEBHOOK_SECRET=your_webhook_secret
BOLD_SECRET_KEY=your_bold_secret_key

# Cryptomus (crypto payments)
CRYPTOMUS_MERCHANT_ID=your_merchant_id
CRYPTOMUS_PAYMENT_KEY=your_payment_key

# Stripe
NEXT_PUBLIC_STRIPE_KEY=pk_live_your_stripe_key

# Resend (password recovery email)
RESEND_API_KEY=re_xxx
MEDUSA_ADMIN_EMAIL=admin@tudominio.com
MEDUSA_ADMIN_PASSWORD=tu_contraseña_admin

# Revalidation
REVALIDATE_SECRET=your_revalidation_secret
