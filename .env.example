# ============================================================
# MedusaJS Backend - Variables de Entorno
# Copia este archivo a .env.local para desarrollo local
# En Coolify: configura cada variable en el panel "Environment"
# ============================================================

# --- Database (PostgreSQL) ---
# Formato: postgres://usuario:password@host:puerto/database
DATABASE_URL=postgres://medusa:medusa_password@postgres:5432/medusa

# --- Redis (opcional, caching/eventos) ---
REDIS_URL=redis://redis:6379

# --- Secrets (¡cambiar en producción!) ---
JWT_SECRET=supersecret_jwt
COOKIE_SECRET=supersecret_cookie

# --- Server ---
PORT=9000
NODE_ENV=production

# --- CORS ---
# Dominios permitidos para el admin y store (separados por comas)
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://admin.tudominio.com
STORE_CORS=http://localhost:8000,https://tienda.tudominio.com

# --- Medusa Admin Onboarding ---
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_BACKEND_URL=http://localhost:7000
MEDUSA_STORE_BACKEND_URL=http://localhost:8000

# --- Stripe Payments (opcional) ---
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Aurapay Payments (custom) ---
AURAPAY_API_KEY=tu_clave_api_aurapay
AURAPAY_WEBHOOK_SECRET=tu_secreto_webhook
AURAPAY_API_URL=https://api.aurapay.com

# --- Cloudinary (opcional - fallback a file-local si no se configura) ---
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# --- Email (Resend) ---
# LICENSE_FROM_EMAIL=licenses@tudominio.com
# RESEND_API_KEY=re_...
